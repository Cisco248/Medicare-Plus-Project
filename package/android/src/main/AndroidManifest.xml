<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility. Required on Android 11+ so that
        HealthConnectClient.getSdkStatus() can see the provider APK and so that
        SettingsManager can resolve Health Connect Intents before starting them.

        The <intent> entries cover the case where the provider is reachable
        through its actions rather than by package name (Android 14+, where
        Health Connect is a platform component).
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />

        <intent>
            <action android:name="androidx.health.ACTION_HEALTH_CONNECT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="androidx.health.ACTION_MANAGE_HEALTH_DATA" />
        </intent>
    </queries>

    <!--
        This plugin intentionally declares no android.permission.health.* entries
        and no permissions-rationale Activity.

        Health Connect permissions must be declared by the host application,
        which is the entity that justifies each one to the user and to Play
        review. A library that injects the full permission set would force every
        consumer to request data it never reads.

        The rationale Activity (androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE)
        must likewise live in the host application, because only the application
        can present its own privacy policy. Declaring it here with a class that
        does not exist in the plugin is what previously crashed the permission
        sheet's privacy-policy link with a ClassNotFoundException.

        For the host-side declaration see
        client/android/app/src/main/AndroidManifest.xml and
        client/android/app/src/main/kotlin/com/example/client/PermissionsRationaleActivity.kt
    -->

</manifest>
