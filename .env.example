# Copy values into server/.env and rag/.env. Never commit real secrets.

# Server
MYSQL_HOST=mysql-server
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=medicare_plus
JWT_SECRET_KEY=replace-with-a-long-random-secret
RAG_HOST=http://rag-systemd
RAG_PORT=8000
# Cloud Run: set the full HTTPS URL instead of host/port
# RAG_BASE_URL=https://medicare-plus-rag-xxxxx-ew.a.run.app

# Model artifacts (gs://server-models/base/diabetes/...)
BUCKET_NAME=server-models
MODEL_DIR=./artifact

# RAG
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
CHROMA_HOST=chroma-server
CHROMA_PORT=3000
COLLECTION_NAME=medicare-knowledge
